# ===================================================================
# MẪU CẤU HÌNH BIẾN MÔI TRƯỜNG BACKEND (.env.example)
# Copy file này thành .env hoặc dán vào GitHub Secret ENV_PRODUCTION
# ===================================================================

# 1. Cổng chạy Backend (Mặc định: 8080)
PORT=8080

# 2. Cấu hình Cơ sở dữ liệu MySQL
# - Môi trường Local: jdbc:mysql://localhost:3306/ban_hang_viet?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
# - Môi trường VPS Docker (kết nối MySQL cài trên VPS): jdbc:mysql://host.docker.internal:3306/ban_hang_viet?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_URL=jdbc:mysql://localhost:3306/ban_hang_viet?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USER=root
DB_PASSWORD=root

# 3. Cấu hình Email (Gmail SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password-16-chars

# 4. Bảo mật JWT Token (Chuỗi Secret 256-bit)
JWT_SECRET=9a4f2c8d3e1b7f0a5c8d2e4b6a1f3c5e7a9b0c2d4e6f8a0b1c3d5e7f9a1b3c5e
JWT_EXPIRATION_MS=86400000

# 5. URL Frontend (Cấu hình CORS)
# Production trên VPS: http://<IP_VPS_CUA_BAN>
FRONTEND_URL=http://localhost
