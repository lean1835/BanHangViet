# ==============================================================
#  BanHangViet — Frontend Environment Variables (Template)
#  Sao chép file này thành .env hoặc .env.local và điền giá trị thực tế:
#    cp .env.example .env
#  LƯU Ý: Tuyệt đối KHÔNG commit các file .env / .env.* vào Git (đã cấu hình trong .gitignore).
# ==============================================================

# --- API ---
# URL gốc của Backend API (Spring Boot)
VITE_API_URL=http://localhost:8080/api/v1

# --- App ---
# Môi trường chạy ứng dụng: development | production
VITE_APP_ENV=development
